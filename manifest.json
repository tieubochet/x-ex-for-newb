{
  "manifest_version": 3,
  "name": "X - Extension for Newbie",
  "version": "1.0",
  "description": "Extension for Newbie - Ver 0.0.1",
  "permissions": [
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["keys.txt", "promts.txt"],
      "matches": ["https://x.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "48": "icon.jpeg"
  }
}