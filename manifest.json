{
  "manifest_version": 3,
  "name": "Farcaster Gemini Translator",
  "version": "1.0",
  "description": "Dịch các bài viết trên Farcaster bằng Google Gemini.",
  "permissions": [
    "storage"  // Để lưu API key
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/" // Cho phép gọi API Gemini
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.farcaster.xyz/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Farcaster Gemini Translator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}